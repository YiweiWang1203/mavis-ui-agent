+"""Browser observation is supplementary to the existing source contract."""
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import playwright
+
+
+def observe(folder, plan, viewport):
+    destination = folder / "action-observation"
+    destination.mkdir(exist_ok=True)
+    items = plan.get("actions", [])
+    report = destination / "report.json"
+    if os.environ.get("MAVIS_ACTION_OBSERVER", "1") == "0":
+        report.write_text(json.dumps({"reason":"disabled","results":[]}))
+        return []
+    reason = "no action definitions"
+    if isinstance(items, list) and items:
+        spec = destination / "plan.json"
+        spec.write_text(json.dumps({"version": 1, "viewport": dict(zip(("width", "height"), viewport)),
+                                   "actions": items}, ensure_ascii=False))
+        driver = Path(playwright.__file__).parent / "driver"
+        script = Path(__file__).resolve().parents[2] / "scripts/observe_prototype_actions.cjs"
+        try:
+            subprocess.run([str(driver / "node"), str(script), str(folder / "final.html"),
+                            str(spec), str(destination)], check=True, capture_output=True,
+                           timeout=150, env={**os.environ, "MAVIS_PLAYWRIGHT_MODULE": str(driver / "package")})
+            return json.loads(report.read_text())["results"]
+        except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
+            reason = type(error).__name__
+    results = [{"id": item.get("id"), "status": "not_evaluated", "reason": reason}
+               for item in items if isinstance(item, dict)] if isinstance(items, list) else []
+    report.write_text(json.dumps({"reason": reason, "results": results}))
+    return results
+
+
+def choose(first, candidate):
+    def successes(entry):
+        checks = {("action", str(row.get("id"))) for row in entry[4] if row["status"] == "passed"}
+        for field, key in (("results", "target"), ("relations", "relation")):
+            for row in entry[5].get(field, []):
+                if row.get("passed"):
+                    checks.add((field, json.dumps(row[key], sort_keys=True)))
+        return checks
+    if first[3] and not candidate[3] or successes(first) - successes(candidate):
+        return first
+    return candidate
+
+
+def publish_first(output, folder, result, selected, passed, actions, detail):
+    for path in folder.iterdir():
+        if path.is_file():
+            shutil.copy2(path, output / path.name)
+    shutil.copytree(folder / "acceptance", output / "acceptance")
+    (output / "action-selection.json").write_text(json.dumps({"selected": selected, "repair_error": detail,
+                                                              "actions": actions}, ensure_ascii=False))
+    return {**result, "html_path": str(output / "final.html"), "page_stage": selected, "source_page_passed": passed}
