# .env.example

# === 核心平台配置 ===
# 将真实密钥填入本地 `.env`，不要将真实密钥提交到仓库。
SILICONFLOW_API_KEY="sk-your-siliconflow-api-key-here"
SILICONFLOW_BASE_URL="https://api.siliconflow.cn/v1"

# === 路由配置 ===
# 让使用 OpenAI SDK 的库（如 LangChain）默认请求硅基流动
OPENAI_API_KEY=${SILICONFLOW_API_KEY}
OPENAI_BASE_URL=${SILICONFLOW_BASE_URL}

# === 可选/备用 Keys（占位） ===
REASONING_API_KEY="sk-your-reasoning-api-key-here"
BASIC_API_KEY="sk-your-basic-api-key-here"
VL_API_KEY="sk-your-vl-api-key-here"

# === 视觉感知 (Vision) ===
VISION_MODEL="Qwen/Qwen2.5-VL-7B-Instruct"

# === 核心执行器 (Coder) ===
# 调试阶段使用轻量/低成本模型，生产/渲染阶段切换到 DeepSeek-V3
CODER_MODEL="Qwen/Qwen2.5-Coder-32B-Instruct"
CODER_PROD_MODEL="deepseek-ai/DeepSeek-V3"

# === 其他辅助 API（占位） ===
TAVILY_API_KEY="tvly-your-key-here"
DEEPSEEK_API_KEY="sk-your-deepseek-api-key-here"

# === 使用说明 ===
# 1) 复制本文件为 .env
# 2) 将真实密钥填入 .env
# 3) 确保 .gitignore 包含 .env