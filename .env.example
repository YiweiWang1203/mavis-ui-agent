# Copy this file to .env and fill real secrets locally.
# Never commit real API keys or host-specific absolute paths.

# === Workspace paths ===
# Root directory used for outputs, transcripts, and local model lookup.
# Ubuntu example: /wyw/meeting_agent_workspace/my_agent
# Windows example: D:\agentworkspace\mavis-ui-agent
MAVIS_WORKSPACE_ROOT=""

# Optional local FunASR model cache. If empty, defaults to:
# ${MAVIS_WORKSPACE_ROOT}/data/models/iic
FUNASR_MODELS_DIR=""

# cuda, cpu, or any device string supported by FunASR/torch.
ASR_DEVICE="cuda"

# === SiliconFlow / OpenAI-compatible endpoint ===
SILICONFLOW_API_KEY="sk-your-siliconflow-api-key-here"
SILICONFLOW_BASE_URL="https://api.siliconflow.cn/v1"

# Let OpenAI SDK compatible libraries route to SiliconFlow by default.
OPENAI_API_KEY=${SILICONFLOW_API_KEY}
OPENAI_BASE_URL=${SILICONFLOW_BASE_URL}

# === Agent model keys ===
REASONING_API_KEY="sk-your-reasoning-api-key-here"
REASONING_BASE_URL=${SILICONFLOW_BASE_URL}
REASONING_MODEL="Qwen/Qwen3-32B"

BASIC_API_KEY="sk-your-basic-api-key-here"
BASIC_BASE_URL=${SILICONFLOW_BASE_URL}
BASIC_MODEL="Qwen/Qwen2.5-72B-Instruct"

VL_API_KEY="sk-your-vl-api-key-here"
VL_BASE_URL=${SILICONFLOW_BASE_URL}
VL_MODEL="Qwen/Qwen2.5-VL-7B-Instruct"

# === Vision extraction ===
VISION_MODEL="Qwen/Qwen2.5-VL-7B-Instruct"
VISION_BASE_URL=${SILICONFLOW_BASE_URL}
VISION_COMPLETENESS_THRESHOLD="0.65"

# === Coder ===
CODER_MODEL="Qwen/Qwen2.5-Coder-32B-Instruct"
CODER_PROD_MODEL="deepseek-ai/DeepSeek-V3"

# === Optional services ===
TAVILY_API_KEY="tvly-your-key-here"
DEEPSEEK_API_KEY="sk-your-deepseek-api-key-here"
CHROME_INSTANCE_PATH=""

# === Preprocess / runtime ===
PREPROCESS_OUTPUT_DIR="outputs/preprocess"
DEFAULT_ROTATE_DEGREES="180"
