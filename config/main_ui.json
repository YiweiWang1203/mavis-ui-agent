{
  "version": "main-ui-video-v1",
  "enable_asr": true,
  "max_physical_requests_per_case": 4,
  "max_output_tokens": 8192,
  "timeout_seconds": 600,
  "automatic_retries": 0,
  "environment": {
    "VISION_MODEL": "Qwen/Qwen3-VL-32B-Instruct",
    "CODER_MODEL": "Qwen/Qwen3-VL-32B-Instruct",
    "CODER_PROD_MODEL": "Qwen/Qwen3-VL-32B-Instruct",
    "UI_RENDERER_MODE": "llm",
    "UI_CODER_CONTRACT_MODE": "main_system_v1",
    "UI_LAYOUT_MODE": "preserve_target",
    "UI_FUSION_MODE": "source_alignment_v1",
    "UI_INPUT_CONTRACT_MODE": "off",
    "UI_STRUCTURE_MODE": "baseline",
    "UI_SEMANTIC_TYPE_MODE": "off",
    "UI_RELATION_SPECIALIST_MODE": "off",
    "UI_INPUT_SEMANTIC_AUDIT_MODE": "off",
    "UI_COORDINATE_RESPONSIBILITY_MODE": "off",
    "UI_RELATION_AGGREGATION_MODE": "off",
    "VISION_MAX_RETRIES": "1",
    "UI_MAIN_LAYOUT_REPORT_ONLY": "1",
    "LAYOUT_SOLVER_ENABLED": "1"
  }
}
