{
  "allowed_extensions": [
    ".cfg",
    ".html",
    ".j2",
    ".jinja",
    ".json",
    ".md",
    ".py",
    ".sh",
    ".toml",
    ".txt",
    ".yaml",
    ".yml"
  ],
  "allowed_paths": [
    ".env.example",
    ".gitattributes",
    ".gitignore",
    "ARCHITECTURE.md",
    "LICENSE",
    "README*.md",
    "pyproject.toml",
    "pytest.ini",
    "requirements*.txt",
    "setup.cfg",
    "setup.py",
    "src/*.html",
    "src/*.j2",
    "src/*.jinja",
    "src/*.json",
    "src/*.md",
    "src/*.py",
    "src/*.yaml",
    "src/*.yml",
    "src/**/*.html",
    "src/**/*.j2",
    "src/**/*.jinja",
    "src/**/*.json",
    "src/**/*.md",
    "src/**/*.py",
    "src/**/*.yaml",
    "src/**/*.yml",
    "templates/**",
    "tests/*.json",
    "tests/*.py",
    "tests/*.yaml",
    "tests/*.yml",
    "tests/**/*.json",
    "tests/**/*.py",
    "tests/**/*.yaml",
    "tests/**/*.yml",
    "tox.ini"
  ],
  "credential_field_patterns": [
    "API_KEY",
    "TOKEN",
    "PASSWORD",
    "SECRET",
    "ACCESS_KEY",
    "PRIVATE_KEY",
    "AUTH",
    "CREDENTIAL"
  ],
  "credential_value_prefixes": [
    "sk-",
    "ghp_",
    "github_pat_",
    "Bearer",
    "hf_",
    "tvly-",
    "xoxb-",
    "AKIA"
  ],
  "allowed_script_paths": [
    "scripts/run_video_ui_workflow.py"
  ],
  "denied_extensions": [
    ".7z",
    ".avi",
    ".bin",
    ".bmp",
    ".ckpt",
    ".db",
    ".dll",
    ".exe",
    ".flac",
    ".gif",
    ".gz",
    ".ipynb",
    ".jpeg",
    ".jpg",
    ".mkv",
    ".mov",
    ".mp3",
    ".mp4",
    ".onnx",
    ".pickle",
    ".pkl",
    ".png",
    ".pt",
    ".pth",
    ".pyd",
    ".pyc",
    ".pyo",
    ".safetensors",
    ".so",
    ".sqlite",
    ".sqlite3",
    ".tar",
    ".wav",
    ".webp",
    ".zip"
  ],
  "denied_paths": [
    ".git/**",
    "**/*__pycache__*/**",
    "cache/**",
    "checkpoints/**",
    "data/**",
    "env_setup/**",
    "experiments/**",
    "logs/**",
    "models/**",
    "output/**",
    "outputs/**",
    "tests/tools/**",
    "tests/download_sketches.py",
    "tests/test_real_data.py",
    "weights/**"
  ],
  "legacy_filename_rules": {
    "case_insensitive_tokens": [
      "_old",
      "-old",
      ".old",
      "old_",
      "old-",
      "old."
    ],
    "unicode_tokens": [
      "\u65e7"
    ]
  },
  "max_file_size_bytes": 1048576,
  "policy_version": "2026-07-08.1",
  "public_host_allowlist": [
    "api.openai.com",
    "api.siliconflow.cn",
    "finance.sina.com.cn",
    "fintel.io",
    "jina.ai",
    "localhost",
    "127.0.0.1",
    "0.0.0.0",
    "example.com",
    "example.org",
    "r.jina.ai"
  ],
  "safe_placeholder_patterns": [
    "^$",
    "^YOUR_[A-Z0-9_]+$",
    "^<[A-Z0-9_]+>$",
    "^\\$\\{[A-Z0-9_]+\\}$",
    "placeholder(?:_[A-Z0-9]+)*",
    "example(?:_[A-Z0-9]+)*",
    "redacted(?:_[A-Z0-9]+)*",
    "changeme"
  ],
  "schema_version": 1,
  "special_sanitizers": {
    ".env.example": "dotenv",
    "src/prompts/**": "prompt_text"
  }
}
